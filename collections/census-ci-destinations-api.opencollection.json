{
  "opencollection": "1.0.0",
  "info": {
    "name": "Census Management Connectors Destinations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Destinations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List destinations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.getcensus.com/api/v1/destinations",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated results."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of records per page."
              }
            ]
          },
          "docs": "List destinations"
        },
        {
          "info": {
            "name": "Create a destination",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.getcensus.com/api/v1/destinations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a destination"
        },
        {
          "info": {
            "name": "Fetch a destination",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.getcensus.com/api/v1/destinations/:destination_id",
            "params": [
              {
                "name": "destination_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fetch a destination"
        },
        {
          "info": {
            "name": "List destination objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.getcensus.com/api/v1/destinations/:destination_id/objects",
            "params": [
              {
                "name": "destination_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Lists the objects Census can write to in the destination."
        }
      ]
    }
  ],
  "bundled": true
}